{
  "name": "darkpyonix-hub-worker",
  "version": "0.3.0",
  "private": true,
  "description": "darkpyonix.dev hub API on Cloudflare Workers (SPEC §10)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
