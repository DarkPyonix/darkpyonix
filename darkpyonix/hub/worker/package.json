{
  "name": "darkpyonix-hub-worker",
  "version": "0.3.0",
  "private": true,
  "description": "darkpyonix.dev hub API on Cloudflare Workers (SPEC §10)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "migrate:local": "wrangler d1 migrations apply darkpyonix-hub --local",
    "migrate:remote": "wrangler d1 migrations apply darkpyonix-hub --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0",
    "yaml": "^2.8.0"
  }
}
