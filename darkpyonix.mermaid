---
title: DarkPyonix kernel stack — object model
---
classDiagram
    direction LR

    %% ───────────── Notebook format (darkpyonix.format, stdlib only) ─────────────
    namespace format {
        class NotebookDocument {
            +path str
            +preamble Cell
            +cells list~Cell~
            +file_sha256 str
            +parse(text str, path str)$ NotebookDocument
            +load(path str)$ NotebookDocument
            +serialize() str
            +cell(index int) Cell
        }
        class Cell {
            +index int
            +type CellType
            +title str|None
            +metadata dict
            +source str
            +marker str
            +source_sha256 str
            +id str|None
        }
        class CellType {
            <<enumeration>>
            PREAMBLE
            CODE
            MARKDOWN
            ARGPARSE
            BINDING
            SHELL
            PARALLEL
            CONCURRENT
            CINTEROP
            CPPINTEROP
            RUSTINTEROP
        }
    }
    NotebookDocument "1" *-- "1..*" Cell
    Cell --> CellType

    %% ───────────── Runtime API (darkpyonix, stdlib only) ─────────────
    namespace runtime {
        class darkpyonix {
            <<module>>
            +params Params
            +uv Uv
            +pip Pip
            +markdown(text str, silent bool) None
            +display(obj object) None
            +binding(obj) object
            +run_command(cmd str, check bool) int
            +run_parallel(*aws) list
            +run_cinterop(src str) None
            +run_cppinterop(src str) None
            +run_rustinterop(src str) None
        }
        class Params {
            -overrides dict
            -argv list~str~
            +get(name str, default, choices, range, type, help) object
        }
        class RuntimeHost {
            <<interface>>
            +emit_display(bundle dict, silent bool) None
            +params_overrides() dict
            +in_kernel() bool
        }
        class PlainHost {
            +emit_display(bundle dict, silent bool) None
        }
    }
    darkpyonix --> Params
    darkpyonix ..> RuntimeHost : delegates to
    RuntimeHost <|.. PlainHost
    Params ..> RuntimeHost

    %% ───────────── Kernel (darkpyonix.kernel, stdlib only) ─────────────
    namespace kernel {
        class Kernel {
            <<process main>>
            +identity KernelIdentity
            +status KernelStatus
            +executor Executor
            +server ControlServer
            +discovery DiscoveryResponder
            +router OutputRouter
            +runs RunStore
            +main(argv list) int
            +shutdown() None
        }
        class KernelIdentity {
            +kernel_id str
            +path str
            +user_tag str
            +from_path(path str)$ KernelIdentity
        }
        class FileLock {
            -fd int
            +acquire() bool
            +release() None
        }
        class KernelStatus {
            <<enumeration>>
            STARTING
            IDLE
            BUSY
            STOPPING
        }
        class Executor {
            <<main thread>>
            +namespace dict
            +execution_count int
            -queue Queue~RunRequest~
            +submit(req RunRequest) RunTicket
            +interrupt() bool
            +restart(hard bool) None
            +run_forever() None
            -execute_cell(cell Cell, run Run) CellResult
        }
        class RunRequest {
            +run_id str
            +mode str
            +cells list~int~
            +source str|None
            +params dict
            +on_busy str
        }
        class Run {
            +run_id str
            +status RunStatus
            +started_at datetime
            +ended_at datetime|None
            +cells list~CellRecord~
            +to_notebook() dict
        }
        class CellRecord {
            +cell Cell
            +status str
            +execution_count int
            +outputs list~dict~
            +started_at datetime
            +ended_at datetime|None
        }
        class RunStatus {
            <<enumeration>>
            QUEUED
            RUNNING
            OK
            ERROR
            INTERRUPTED
            CANCELLED
            CRASHED
        }
        class OutputRouter {
            <<output thread>>
            -queue Queue
            +write_stream(name str, text str) None
            +write_display(bundle dict, kind str) None
            +clear(wait bool) None
            -flush_loop() None
        }
        class StreamCapture {
            +name str
            +write(text str) int
            +flush() None
        }
        class FdCapture {
            <<fd reader thread>>
            +fd int
            +start() None
        }
        class DisplayHook {
            +format_bundle(obj) dict
            +displayhook(value) None
        }
        class KernelHost {
            +emit_display(bundle dict, silent bool) None
            +params_overrides() dict
        }
        class RunStore {
            +dir str
            +save(run Run, final bool) None
            +list(limit int) list~dict~
            +get(run_ref str) dict
            +recover_crashed() None
        }
        class RunsMagic {
            <<magic variable>>
            +current dict|None
            +latest dict|None
            +dir str
            +list(limit int) list~dict~
            +__getitem__(key) dict
        }
        class ControlServer {
            <<control thread>>
            +port int
            -sessions list~ClientSession~
            +serve_forever() None
            +broadcast(event Event) None
        }
        class ClientSession {
            +session_id str
            +subscribed bool
            +handle(frame dict) None
            +send(frame dict) None
        }
        class EventLog {
            +seq int
            -ring deque~Event~
            +append(type str, data dict) Event
            +since(seq int) list~Event~
        }
        class DiscoveryResponder {
            <<discovery thread>>
            +group str
            +port int
            +announce() None
            +bye() None
            -on_query(msg dict, addr) None
        }
        class Registry {
            +write(info dict) None
            +remove() None
        }
    }
    Kernel *-- KernelIdentity
    Kernel *-- FileLock
    Kernel *-- Executor
    Kernel *-- OutputRouter
    Kernel *-- RunStore
    Kernel *-- ControlServer
    Kernel *-- DiscoveryResponder
    Kernel *-- EventLog
    Kernel --> KernelStatus
    Executor ..> NotebookDocument : parses
    Executor --> RunRequest
    Executor --> Run : executes
    Run *-- CellRecord
    Run --> RunStatus
    CellRecord --> Cell
    StreamCapture ..> OutputRouter : sys.stdout / sys.stderr
    FdCapture ..> OutputRouter : fd 1 / fd 2
    DisplayHook ..> OutputRouter
    KernelHost ..|> RuntimeHost
    KernelHost ..> OutputRouter
    OutputRouter ..> EventLog : events
    OutputRouter ..> RunStore : throttled saves
    RunsMagic ..> RunStore
    Executor ..> RunsMagic : injects as __runs__
    ControlServer *-- ClientSession
    ControlServer ..> EventLog : replay
    ClientSession ..> Executor : run / interrupt / restart
    DiscoveryResponder ..> Registry : mirrors announce

    %% ───────────── Manager (darkpyonix.manager) ─────────────
    namespace manager {
        class ManagerApp {
            +mode ManagerMode
            +config ManagerConfig
            +directory KernelDirectory
            +auth AuthService
            +broker EventBroker
            +app FastAPI
            +run() None
        }
        class ManagerMode {
            <<enumeration>>
            EPHEMERAL
            DEDICATED
        }
        class ManagerConfig {
            +host str
            +port int
            +idle_timeout int|None
            +home str
        }
        class KernelDirectory {
            -kernels dict~str, KernelInfo~
            +discover(refresh bool) list~KernelInfo~
            +get(kernel_id str) KernelInfo
            +ensure(path str, python str) KernelInfo
            +client(kernel_id str) KernelClient
        }
        class KernelInfo {
            +kernel_id str
            +path str
            +pid int
            +port int
            +status str
            +python dict
        }
        class DiscoveryClient {
            +query(kernel_id str|None) list~dict~
            +listen() None
            +scan_registry() list~dict~
        }
        class KernelLauncher {
            +python str
            +bootstrap(kernel_root str) str
            +launch(path str, cwd str, env dict) int
        }
        class KernelClient {
            +connect() None
            +request(method str, params dict) dict
            +subscribe(since int) AsyncIterator~Event~
            +close() None
        }
        class EventBroker {
            +stream(kernel_id str, since int, permission Permission) AsyncIterator~Event~
        }
        class AuthService {
            +master_token str
            +check(token str) Principal
            +create_share(kernel_id str, permission Permission) ShareToken
            +revoke(share_id str) None
        }
        class Principal {
            +permission Permission
            +kernel_id str|None
            +can(action str) bool
        }
        class Permission {
            <<enumeration>>
            ADMIN
            VIEWER3
            VIEWER2
            VIEWER1
        }
        class ShareToken {
            +share_id str
            +kernel_id str
            +permission Permission
            +token_hash str
            +expires_at datetime|None
        }
        class LifecycleWatchdog {
            +idle_timeout int
            +touch() None
            +run() None
        }
        class ManagerRegistry {
            +publish(url str, token str) None
            +find_alive()$ list~dict~
        }
        class Cli {
            <<darkpyonix CLI>>
            +main(argv list) int
            -ensure_manager() ManagerHandle
        }
    }
    ManagerApp --> ManagerMode
    ManagerApp *-- ManagerConfig
    ManagerApp *-- KernelDirectory
    ManagerApp *-- AuthService
    ManagerApp *-- EventBroker
    ManagerApp *-- LifecycleWatchdog
    ManagerApp ..> ManagerRegistry : ephemeral only
    KernelDirectory *-- DiscoveryClient
    KernelDirectory *-- KernelLauncher
    KernelDirectory --> KernelInfo
    KernelDirectory ..> KernelClient
    EventBroker ..> KernelClient
    AuthService --> Principal
    AuthService *-- ShareToken
    Principal --> Permission
    ShareToken --> Permission
    Cli ..> ManagerRegistry : finds or spawns
    Cli ..> ManagerApp : HTTP

    %% ───────────── Wire boundaries ─────────────
    KernelClient ..> ControlServer : DKP/1 over loopback TCP (HMAC handshake)
    DiscoveryClient ..> DiscoveryResponder : UDP multicast 239.255.68.80 port 46880
    KernelLauncher ..> Kernel : spawns detached

    %% ───────────── Hub (Draft) ─────────────
    namespace hub {
        class HubApp {
            <<darkpyonix.dev, Draft>>
        }
        class Device {
            +device_id str
            +role str
            +public_key str
        }
        class Rendezvous {
            +offer(from Device, to Device, candidates list) None
        }
        class Relay {
            +pipe(session_id str) None
        }
        class PublishedShare {
            +share_id str
            +device_id str
        }
    }
    HubApp *-- Device
    HubApp *-- Rendezvous
    HubApp *-- Relay
    HubApp *-- PublishedShare
    PublishedShare ..> ShareToken : refers to (token never sent to hub)
